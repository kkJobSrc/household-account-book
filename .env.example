DATABASE_URL=sqlite:///./data/kakeibo.db

# Base URL of the optional OCR microservice (see ocr/, started via
# `docker compose --profile ocr up -d`). Only needs to change if you run
# the OCR service under a different name/port than the docker-compose default.
OCR_SERVICE_URL=http://ocr:8002

# Timeout (seconds) backend waits for a single POST /ocr/process call to
# the OCR service before treating it as unreachable (receipt is requeued
# as "pending" for the next scan).
OCR_REQUEST_TIMEOUT=30
